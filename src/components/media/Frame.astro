---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { placeholderGradient } from "~/lib/media/placeholder";

interface Props {
  src?: ImageMetadata | undefined;
  alt: string;
  caption?: string | undefined;
  class?: string | undefined;
  ratio?: string; // aspect-ratio, e.g. "4/3", "3/4", "16/9"
  seed?: number; // varies the placeholder gradient
  parallax?: boolean; // gentle vertical drift (handled by the motion runtime)
  fill?: boolean; // fill a fixed-height parent (object-cover), instead of using aspect-ratio
  widths?: number[];
  sizes?: string;
  // Mark above-the-fold / hero images so the browser fetches them eagerly with
  // high priority. Without this the default loading="lazy" + fetchpriority=auto
  // delays the LCP and Lighthouse flags `lcp-lazy-loaded` + `lcp-discovery-insight`.
  priority?: boolean;
}
const {
  src,
  alt,
  caption,
  class: className,
  ratio = "4/3",
  seed = 0,
  parallax = false,
  fill = false,
  widths = [400, 800, 1200, 1600],
  sizes = "(min-width: 1024px) 50vw, 100vw",
  priority = false,
} = Astro.props;
---

<figure class:list={["m-0", fill && "absolute inset-0", className]}>
  <div
    class:list={["bg-bone-2 relative overflow-hidden", fill && "h-full w-full"]}
    style={fill ? undefined : `aspect-ratio: ${ratio};`}
  >
    <div
      class:list={["absolute inset-0", parallax && "-top-10% h-[120%]"]}
      data-parallax={parallax ? "8" : undefined}
      style={`background: ${placeholderGradient(seed)};`}
      role={src ? undefined : "img"}
      aria-label={src ? undefined : alt}
    >
      {
        src ? (
          /*
            <Picture> emits <picture><source type="image/avif"><source type="image/webp"><img …>,
            so the browser picks AVIF where supported and falls back to WebP otherwise. Using
            <Image> alone produced a single WebP and Lighthouse's `image-delivery-insight`
            scored ~0.5 because AVIF wasn't being served on a photography-led site.
          */
          <Picture
            src={src}
            alt={alt}
            formats={["avif", "webp"]}
            widths={widths}
            sizes={sizes}
            loading={priority ? "eager" : "lazy"}
            fetchpriority={priority ? "high" : "auto"}
            class="image-fade block h-full w-full object-cover"
          />
        ) : (
          import.meta.env.DEV && (
            <span class="text-ink/70 absolute bottom-2 left-2 font-mono text-[10px] tracking-[0.14em] uppercase">
              Photo placeholder — {alt}
            </span>
          )
        )
      }
    </div>
  </div>
  {
    caption && (
      <figcaption class="text-ink-3 mt-3 font-mono text-[10px] tracking-[0.18em] uppercase">
        {caption}
      </figcaption>
    )
  }
</figure>
