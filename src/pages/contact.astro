---
import PageLayout from "~/layouts/PageLayout.astro";
import PageHero from "~/components/sections/PageHero.astro";
import { SITE } from "~/data/site";

// Web3Forms access key (https://web3forms.com) — set PUBLIC_WEB3FORMS_ACCESS_KEY in .env.
// It only authorises posting to your form, so it is safe to expose to the client.
const WEB3FORMS_ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";

// Each studio gets approximate dot coordinates on a 200x100 world map (lon/lat → x/y)
const studioDots = [
  { city: "Oslo", x: 105, y: 30 },
  { city: "Lisbon", x: 91, y: 50 },
  { city: "Kyoto", x: 165, y: 48 },
];

const dotCandidates = Array.from({ length: 600 }, (_, i) => {
  const x = (i * 17) % 200;
  const y = (i * 11) % 100;
  const inLandRoughly = y > 18 && y < 70 && ((x > 80 && x < 175) || (x > 5 && x < 60));
  return inLandRoughly ? { x, y } : null;
}).filter((d): d is { x: number; y: number } => d !== null);
---

<PageLayout
  title="Contact — Norven"
  description="Bring us a site, a story, a single hour of light. Studios in Oslo, Lisbon, and Kyoto."
>
  <PageHero
    eyebrow="Brief"
    title={"Bring us\na site."}
    subtitle="We accept three to five new commissions per year and read every brief carefully. Expect a personal response within fourteen days, usually sooner. Briefs from outside our usual region are welcome — distance is not a barrier; lack of intent is."
  />

  <section class="bg-bone py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
        <!-- FORM -->
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          data-contact-email={SITE.email}
          class="space-y-8"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value={`New brief — ${SITE.name}`} />
          <input type="hidden" name="from_name" value={`${SITE.name} website`} />
          {/* Honeypot: invisible to people; bots that fill every field get rejected. */}
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="hidden" />

          {
            import.meta.env.DEV && !WEB3FORMS_ACCESS_KEY && (
              <p class="border-ink/40 text-ink-3 border border-dashed px-4 py-3 font-mono text-[11px] leading-relaxed tracking-[0.14em] uppercase">
                Dev notice — set PUBLIC_WEB3FORMS_ACCESS_KEY in .env to enable delivery.
              </p>
            )
          }

          <div data-reveal>
            <label for="name" class="eyebrow mb-3 block">Name</label>
            <input
              type="text"
              id="name"
              name="Name"
              required
              autocomplete="name"
              class="border-line-2 focus:border-ink bg-bone w-full border-b py-3 font-sans text-base transition-colors outline-none"
            />
          </div>
          <div data-reveal>
            <label for="email" class="eyebrow mb-3 block">Email</label>
            <input
              type="email"
              id="email"
              name="Email"
              required
              autocomplete="email"
              class="border-line-2 focus:border-ink bg-bone w-full border-b py-3 font-sans text-base transition-colors outline-none"
            />
          </div>
          <div data-reveal>
            <label for="kind" class="eyebrow mb-3 block">Project type</label>
            <select
              id="kind"
              name="Project type"
              class="border-line-2 focus:border-ink bg-bone w-full border-b py-3 font-sans text-base transition-colors outline-none"
            >
              <option>Residence</option>
              <option>Cultural</option>
              <option>Commercial</option>
              <option>Civic</option>
              <option>Landscape</option>
              <option>Research / publication</option>
            </select>
          </div>
          <div data-reveal>
            <label for="brief" class="eyebrow mb-3 block">A short brief</label>
            <textarea
              id="brief"
              name="Brief"
              rows="6"
              required
              class="border-line-2 focus:border-ink bg-bone w-full resize-none border-b py-3 font-sans text-base transition-colors outline-none"
            ></textarea>
          </div>
          <button
            type="submit"
            data-form-submit
            class="border-ink text-ink hover:bg-ink hover:text-bone border px-8 py-4 font-mono text-xs tracking-[0.18em] uppercase transition-colors disabled:cursor-not-allowed disabled:opacity-50"
          >
            Send brief →
          </button>
          <p
            data-form-status
            role="status"
            aria-live="polite"
            class="font-mono text-sm leading-relaxed tracking-[0.02em]"
          >
          </p>
        </form>

        <!-- DETAILS -->
        <aside class="space-y-12">
          <div data-reveal>
            <p class="eyebrow mb-4">Direct</p>
            <a
              href={`mailto:${SITE.email}`}
              class="font-display text-ink hover:text-brass block text-2xl transition-colors"
            >
              {SITE.email}
            </a>
            <a
              href={`tel:${SITE.phone.replaceAll(" ", "")}`}
              class="text-ink-3 mt-2 block font-mono text-sm"
            >
              {SITE.phone}
            </a>
          </div>
          <div data-reveal>
            <p class="eyebrow mb-4">Studios</p>
            <ul class="space-y-6">
              {
                SITE.studios.map((s) => (
                  <li>
                    <h3 class="font-display text-ink text-xl">{s.city}</h3>
                    <p class="text-ink-3 mt-1 text-sm leading-relaxed">
                      {s.address}
                      <br />
                      {s.country}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- DOT MAP -->
  <section class="bg-bone-2 py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-10">
      <p class="eyebrow mb-10 text-center" data-reveal>Three latitudes</p>
      <svg
        viewBox="0 0 200 100"
        class="mx-auto block h-auto w-full max-w-3xl"
        aria-label="Map of three studios"
      >
        {/* dotted continents — simplified silhouette */}
        {
          dotCandidates.map((d) => (
            <circle cx={d.x} cy={d.y} r="0.3" fill="var(--color-ink-3)" opacity="0.4" />
          ))
        }
        {
          studioDots.map((d) => (
            <>
              <circle cx={d.x} cy={d.y} r="3" fill="var(--color-brass)" />
              <circle
                cx={d.x}
                cy={d.y}
                r="6"
                fill="none"
                stroke="var(--color-brass)"
                stroke-width="0.4"
                opacity="0.5"
              />
              <text
                x={d.x}
                y={d.y - 8}
                text-anchor="middle"
                font-size="3.5"
                font-family="monospace"
                fill="var(--color-ink)"
              >
                {d.city.toUpperCase()}
              </text>
            </>
          ))
        }
      </svg>
    </div>
  </section>

  <style>
    /* Live region only takes up space once it carries a message. */
    [data-form-status]:empty {
      display: none;
    }
    [data-form-status][data-state="success"] {
      color: var(--color-brass);
    }
    [data-form-status][data-state="error"] {
      color: #b42318;
    }
  </style>

  <script>
    // Progressive enhancement: without JS the form posts natively to Web3Forms.
    // With JS we intercept, submit via fetch, and surface inline status — no reload.
    function setupContactForm() {
      const form = document.getElementById("contact-form");
      if (!(form instanceof HTMLFormElement) || form.dataset.enhanced === "true") return;
      form.dataset.enhanced = "true";

      const status = form.querySelector<HTMLElement>("[data-form-status]");
      const submitButton = form.querySelector<HTMLButtonElement>("[data-form-submit]");
      const defaultLabel = submitButton?.textContent?.trim() ?? "Send brief →";
      const contactEmail = form.dataset.contactEmail ?? "the studio";

      const setStatus = (message: string, state: "success" | "error") => {
        if (!status) return;
        status.textContent = message;
        status.setAttribute("data-state", state);
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!submitButton) return;

        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
        submitButton.textContent = "Sending…";
        status?.removeAttribute("data-state");
        if (status) status.textContent = "";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          });
          const result = await response.json();

          if (response.ok && result.success) {
            form.reset();
            setStatus(
              "Thank you — your brief has reached the studio. We reply within fourteen days.",
              "success",
            );
            submitButton.textContent = "Sent ✓";
            submitButton.removeAttribute("aria-busy");
            return;
          }

          throw new Error(
            typeof result.message === "string" ? result.message : "Submission failed",
          );
        } catch {
          setStatus(`Something went wrong. Please email ${contactEmail} directly.`, "error");
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");
          submitButton.textContent = defaultLabel;
        }
      });
    }

    document.addEventListener("astro:page-load", setupContactForm);
  </script>
</PageLayout>
