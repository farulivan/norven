---
import PageLayout from "~/layouts/PageLayout.astro";
---

<PageLayout
  title="Page not found — Norven"
  description="The page you were looking for has moved, or was never drawn."
>
  <section class="bg-bone relative flex min-h-[78vh] items-center pt-32 pb-20 lg:pt-44 lg:pb-28">
    <div class="mx-auto w-full max-w-[1400px] px-6 lg:px-10">
      <p class="eyebrow text-brass mb-10" data-reveal-lift>Error 404</p>
      <h1
        class="font-display text-ink leading-[0.92]"
        style="font-size: var(--text-display-1)"
        data-reveal-lift
      >
        Not on<br />the plans.
      </h1>
      <p class="text-ink-3 mt-12 max-w-2xl text-lg leading-relaxed lg:text-xl" data-reveal-lift>
        This page has moved, or was never drawn. Let us walk you back to solid ground.
      </p>
      <nav class="mt-14 flex flex-wrap items-center gap-4" aria-label="Recovery" data-reveal>
        <a
          href="/"
          class="border-ink text-ink hover:bg-ink hover:text-bone border px-8 py-4 font-mono text-xs tracking-[0.18em] uppercase transition-colors"
        >
          Return home
        </a>
        <a
          href="/projects"
          class="text-ink-3 hover:text-ink px-6 py-4 font-mono text-xs tracking-[0.18em] uppercase transition-colors"
        >
          View work →
        </a>
      </nav>
    </div>
  </section>
</PageLayout>
